---
import { getCollection } from 'astro:content';
import PersonCard from '../../components/PersonCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import snapshots from '../../data/snapshots.json';
import { sitePath } from '../../lib/paths';
import { groupOf, hasProfile, profilePath, ROLE_LABEL, type Group, type Person } from '../../lib/people';

// Current members in one list, no role sub-headings (each card already shows the role; Joy, 2026-10-15).
const RANK: Record<string, number> = { postdoc: 0, phdCandidate: 1, phd: 2, masters: 3, 'visiting-researcher': 4, collaborator: 5 };
const rankOf = (p: Person) => {
  const g = groupOf(p);
  return RANK[g === 'phd' && /candidate/i.test(p.data.title) ? 'phdCandidate' : g] ?? 9;
};

// Alumni in one list without sub-headings (Joy, 2026-10-15), ordered by former role; unknown role last.
const ALUMNI_ORDER = ['postdoc', 'phd', 'masters', 'visiting-researcher', 'other'];

// Within a rank, `order` (set in each person's file) decides; join year breaks ties.
const byOrder = (a: Person, b: Person) =>
  a.data.order - b.data.order || (a.data.since ?? 9999) - (b.data.since ?? 9999);

const people = await getCollection('people');
const membersOf = (group: Group) => people.filter((p) => groupOf(p) === group).sort(byOrder);
// Faculty row: PI first, then visiting faculty.
const faculty = [...membersOf('pi'), ...membersOf('visiting')];
const isCurrentMember = (p: Person) => !['pi', 'visiting', 'alumni'].includes(groupOf(p));
// Join order: year, then Spring < Summer < Fall; no year sorts last.
const TERMS = ['Spring', 'Summer', 'Fall'];
const joinKey = (p: Person) => (p.data.since ?? 9999) * 10 + (p.data.term ? TERMS.indexOf(p.data.term) : 3);
const bySince = (a: Person, b: Person) => joinKey(a) - joinKey(b);
// Postdocs first, then students by join year and term, then visiting researchers and collaborators (Joy, 2026-10-30).
const TIER: Record<string, number> = { postdoc: 0, phd: 1, masters: 1, 'visiting-researcher': 2, collaborator: 3 };
const tierOf = (p: Person) => TIER[groupOf(p)] ?? 9;
const members = people
  .filter(isCurrentMember)
  .sort((a, b) => tierOf(a) - tierOf(b) || bySince(a, b) || rankOf(a) - rankOf(b) || byOrder(a, b));
const alumni = membersOf('alumni');
const alumniRank = (p: Person) => ALUMNI_ORDER.indexOf(p.data.formerGroup ?? 'other');
const alumniList = [...alumni].sort((a, b) => alumniRank(a) - alumniRank(b));

// Snapshots: portrait first so the feature layout puts it on the left.
const isPortrait = (s: { width: number; height: number }) => s.height > s.width;
const shots = [...snapshots].sort((a, b) => Number(isPortrait(b)) - Number(isPortrait(a)));
const featured = shots.length === 3 && shots.filter(isPortrait).length === 1;
---

<BaseLayout title="People" description="Members of the Climate Resilient and Equitable Infrastructure Lab at Tufts University.">
  <section class="section">
    <div class="wrap">
      <h1>People</h1>

      <section class="people-group" aria-labelledby="people-current">
        <h2 id="people-current">Current Members</h2>
        {/* PI and visiting faculty share the first row (Joy, 2026-10-15). */}
        {faculty.length > 0 && (
          <div class="people-faculty">
            {faculty.map((person) => <PersonCard person={person} pi={groupOf(person) === 'pi'} />)}
          </div>
        )}
        {members.length > 0 && (
          <div class="people-grid">
            {members.map((person) => <PersonCard person={person} />)}
          </div>
        )}
      </section>

      {alumni.length > 0 && (
        <section class="people-group" aria-labelledby="people-alumni">
          <h2 id="people-alumni">Alumni</h2>
          <table class="alumni-table">
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Former role</th>
                <th scope="col">Years</th>
                <th scope="col">Current position</th>
              </tr>
            </thead>
            <tbody>
              {alumniList.map((p) => {
                const role = p.data.formerGroup ? ROLE_LABEL[p.data.formerGroup] : undefined;
                const href = hasProfile(p) ? sitePath(profilePath(p)) : p.data.website;
                return (
                  <tr>
                    <th scope="row" class="alumni-name">{href ? <a href={href}>{p.data.name}</a> : p.data.name}</th>
                    <td class="alumni-role">{role}</td>
                    <td class="alumni-years">{p.data.years}</td>
                    <td class="alumni-current">{p.data.current?.replace(/\.$/, '')}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      )}

      {shots.length > 0 && (
        <section class="people-group snapshots" aria-labelledby="people-snapshots">
          <h2 id="people-snapshots">Snapshots from Lab Activities</h2>
          <ul class:list={['snapshot-mosaic', featured ? 'mosaic-feature' : 'mosaic-masonry']}>
            {shots.map((s) => (
              <li class={isPortrait(s) ? 'is-portrait' : 'is-landscape'}>
                <img src={sitePath(s.src)} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </section>
</BaseLayout>
