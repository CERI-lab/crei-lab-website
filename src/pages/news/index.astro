---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Newest year first; items keep date order within each year.
const years = [...new Set(items.map((item) => item.data.date.getUTCFullYear()))];
const byYear = years.map((year) => ({
  year,
  items: items.filter((item) => item.data.date.getUTCFullYear() === year),
}));

const monthDay = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="News" description="News and media features from the Climate Resilient and Equitable Infrastructure Lab.">
  <section class="section">
    <div class="wrap news">
      <h1>News &amp; Media Features</h1>
      <p class="lede">Grants, awards, publications and press coverage from the lab.</p>
      {items.length === 0 && <p class="empty">No news items yet.</p>}

      {byYear.map(({ year, items: yearItems }) => (
        <section class="news-year" aria-labelledby={`news-${year}`}>
          <h2 id={`news-${year}`}>{year}</h2>
          <ol class="news-list">
            {yearItems.map((item) => {
              const { title, excerpt, category, source, url, date } = item.data;
              return (
                <li class="news-item">
                  <time class="news-date" datetime={date.toISOString().slice(0, 10)}>{monthDay(date)}</time>
                  <div class="news-body">
                    <p class="news-label"><span class={`news-cat news-cat--${category.toLowerCase()}`}>{category}</span>{source && <span class="news-source">{source}</span>}</p>
                    <h3 class="news-title">{url ? <a href={url}>{title}</a> : title}</h3>
                    <p class="news-summary">{excerpt}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
