---
import { sitePath } from '../lib/paths';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hasProfile, profilePath } from '../lib/people';
import { isListedPub } from '../lib/pub-filter';
import { RESEARCH_AREAS } from '../lib/site';

const [people, publications, news, teaching] = await Promise.all([
  getCollection('people'),
  getCollection('publications'),
  getCollection('news'),
  getCollection('teaching'),
]);

const index = [
  { href: sitePath('/'), title: 'Home', kind: 'Page', text: 'climate resilient equitable infrastructure research areas' },
  ...RESEARCH_AREAS.map((area) => ({
    href: sitePath('/'),
    title: area.title,
    kind: 'Research Area',
    text: `${area.body} ${area.chips.join(' ')}`,
  })),
  { href: sitePath('/about'), title: 'About', kind: 'Page', text: 'farshid vahedifard principal investigator biography teaching courses' },
  { href: sitePath('/lab'), title: 'About Our Lab', kind: 'Page', text: 'challenge contribution approach climate extremes equitable infrastructure coastal resilience earthen infrastructure' },
  { href: sitePath('/people'), title: 'People', kind: 'Page', text: 'principal investigator' },
  { href: sitePath('/projects'), title: 'Projects', kind: 'Page', text: '' },
  { href: sitePath('/publications'), title: 'Publications', kind: 'Page', text: '' },
  { href: sitePath('/news'), title: 'News', kind: 'Page', text: '' },
  { href: sitePath('/join'), title: 'Opportunities', kind: 'Page', text: 'join us prospective students collaboration' },
  ...people.map((p) => ({
    href: sitePath(hasProfile(p) ? profilePath(p) : '/people'),
    title: p.data.name,
    kind: 'People',
    text: `${p.data.title} ${p.data.affiliation}`,
  })),
  ...publications.filter(isListedPub).map((p) => ({
    href: sitePath('/publications'),
    title: p.data.title,
    kind: 'Publications',
    text: `${p.data.authors.join(' ')} ${p.data.venue}`,
  })),
  ...news.map((p) => ({
    href: sitePath('/news'),
    title: p.data.title,
    kind: 'News',
    text: p.data.excerpt,
  })),
  ...teaching.map((p) => ({
    href: sitePath('/about'),
    title: p.data.title,
    kind: 'Teaching',
    text: `${p.data.code ?? ''} ${p.data.description ?? ''}`,
  })),
];
---

<BaseLayout title="Search" description="Search the Climate Resilient and Equitable Infrastructure Lab site.">
  <section class="section">
    <div class="wrap search-page">
      <h1>Search</h1>
      <p class="lede">Find people, projects, publications, courses, and news.</p>
      <form class="page-search" action={sitePath('/search')} method="get" role="search">
        <label class="visually-hidden" for="q-page">Search this site</label>
        <input id="q-page" name="q" type="search" placeholder="Search this site" />
        <button type="submit">Search</button>
      </form>
      <p id="search-status" class="empty" role="status" aria-live="polite">Enter a search term above.</p>
      <ol id="search-results" class="search-results"></ol>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ index }}>
  const params = new URLSearchParams(window.location.search);
  const q = (params.get('q') || '').trim().toLowerCase();
  const input = document.getElementById('q-page');
  const status = document.getElementById('search-status');
  const list = document.getElementById('search-results');
  if (input) input.value = params.get('q') || '';
  if (!q) {
    status.textContent = 'Enter a search term above.';
  } else {
    const hits = index.filter((item) =>
      `${item.title} ${item.kind} ${item.text}`.toLowerCase().includes(q),
    );
    if (hits.length === 0) {
      status.textContent = `No results for “${q}”.`;
    } else {
      status.textContent = `${hits.length} result${hits.length === 1 ? '' : 's'}`;
      // Build links with DOM APIs so collection content can never be interpreted as HTML.
      hits.forEach((hit) => {
        const item = document.createElement('li');
        const kind = document.createElement('p');
        kind.className = 'search-kind';
        kind.textContent = hit.kind;
        const title = document.createElement('p');
        title.className = 'search-title';
        const link = document.createElement('a');
        link.href = hit.href;
        link.textContent = hit.title;
        title.append(link);
        item.append(kind, title);
        list.append(item);
      });
    }
  }
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-page > h1 { margin-bottom: var(--space-3); }
  .search-page > .lede { margin: 0 0 var(--space-5); max-width: 40rem; }

  .page-search {
    display: flex;
    gap: var(--space-2);
    max-width: 40rem;
    margin-bottom: var(--space-5);
  }

  .page-search input {
    min-height: 44px;
    min-width: 10rem;
    flex: 1;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    color: var(--color-text);
    font-family: var(--font-ui);
    font-size: 1rem;
    caret-color: var(--color-primary);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .page-search input::placeholder { color: var(--color-text-muted); opacity: 1; }
  .page-search input:hover { border-color: var(--color-text-muted); }
  .page-search input:focus-visible { border-color: var(--color-primary); outline-offset: 1px; }

  .page-search button {
    min-height: 44px;
    min-width: 44px;
    padding: 0 var(--space-5);
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-card);
    background: var(--color-primary);
    color: var(--color-white);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  .page-search button:hover { background: var(--color-link); border-color: var(--color-link); }
  .page-search button:active { transform: translateY(1px); }

  #search-status {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-rule-strong);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-style: normal;
    font-variant-numeric: tabular-nums;
  }

  .search-results {
    max-width: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-results :global(li) { padding-block: 1rem; }
  .search-results :global(li + li) { border-top: 1px solid var(--color-rule); }
  .search-results :global(p) { margin: 0; }

  .search-results :global(.search-kind) {
    margin-bottom: 0.125rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .search-results :global(.search-title) {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .search-results :global(.search-title a) {
    color: var(--color-primary);
    text-decoration: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .search-results :global(.search-title a:hover) { color: var(--color-link); text-decoration-line: underline; }

  @media (prefers-reduced-motion: reduce) {
    .page-search input { transition: none; }
  }
</style>
