---
import type { CollectionEntry } from 'astro:content';
import { sitePath } from '../lib/paths';
import { CEE_PROFILE_URL } from '../lib/site';
import { hasProfile, initialsOf, profilePath } from '../lib/people';
import IconLinks from './IconLinks.astro';

interface Props {
  person: CollectionEntry<'people'>;
  /** Principal Investigator: name links to the Tufts CEE profile. */
  pi?: boolean;
}

const { person, pi = false } = Astro.props;
const { name, title, email, scholar, linkedin, website, photo } = person.data;
const initials = initialsOf(name);
// PI links to the CEE profile (like visiting faculty); postdocs and Ph.D. students to their profile; others to an external page if any.
const nameHref = pi ? CEE_PROFILE_URL : hasProfile(person) ? sitePath(profilePath(person)) : website;
// Styles live in src/styles/parts/people.css so the faculty row can restyle the same markup.
---

<article class="person">
  {photo ? (
    // Decorative: the name follows as text, so screen readers do not hear it twice.
    <img class="person-photo" src={sitePath(photo)} alt="" width="400" height="500" loading={pi ? 'eager' : 'lazy'} fetchpriority={pi ? 'high' : undefined} decoding="async" />
  ) : (
    <div class="person-photo person-initials" aria-hidden="true">{initials}</div>
  )}
  <h3 class="person-name">{nameHref ? <a href={nameHref}>{name}</a> : name}</h3>
  {/* PI: lab role leads the academic title, e.g. "Director, Professor and ..." (Joy, 2026-10-15). */}
  <p class="person-title">{pi ? `Director, ${title}` : title}</p>
  <IconLinks name={name} scholar={scholar} website={website} linkedin={linkedin} email={email} />
</article>
