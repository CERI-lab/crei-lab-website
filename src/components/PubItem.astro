---
import type { CollectionEntry } from 'astro:content';
import { authorSeparator, natureAuthor } from '../lib/cite';
import { labAuthorMatcher } from '../lib/lab-authors';

interface Props {
  pub: CollectionEntry<'publications'>;
}

// One table-of-contents entry: serif title linking to the article, then authors, then
// *Journal* **vol**, pages (year). Inline runs stay on single lines on purpose: JSX newlines
// would render as stray spaces before commas.
const { pub } = Astro.props;
const { title, authors, year, venue, volume, pages, doi, url, pdf, code } = pub.data;
const cleanTitle = title.replace(/\.$/, '');
const href = doi ? `https://doi.org/${doi}` : url;
const isInGroupAuthor = await labAuthorMatcher();
---

<article class="pub-item">
  <h3 class="pub-title">{href ? <a href={href}>{cleanTitle}</a> : cleanTitle}</h3>
  <p class="pub-authors">{authors.map((name, i) => <>{authorSeparator(i, authors.length)}<span class={isInGroupAuthor(name) ? 'author-ingroup' : undefined}>{natureAuthor(name)}</span></>)}</p>
  <p class="pub-source"><em class="pub-venue">{venue}</em>{volume && <>{' '}<b>{volume}</b></>}{pages && <>, {pages}</>}{' '}<span class="pub-year">({year})</span></p>
  {(pdf || code) && (
    <p class="pub-links">
      {pdf && <a href={pdf} aria-label={`PDF of ${title}`}>PDF</a>}
      {code && <a href={code} aria-label={`Code for ${title}`}>Code</a>}
    </p>
  )}
</article>
